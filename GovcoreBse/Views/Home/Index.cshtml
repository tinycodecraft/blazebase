@using Microsoft.Extensions.Localization
@model LoginModel
@inject IStringLocalizerFactory stringFactory
@{
    ViewData["Title"] = "Login Page";
    var Localizer = stringFactory.Create(typeof(GovcoreBse.Resources.SharedResource).Name, typeof(Program).Assembly.GetName().Name!);

    
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>


</div>

<div class="login-container m-auto">
    <div class="login-card">
        <div class="login-header">
            <h2>Sign In</h2>
            <p>Enter your credentials to access your account</p>
        </div>
        <form asp-action="Index" method="post" class="row">
            
            <div class="col-12">
                <div class="input-group has-validation">
                    <span class="input-group-text" id="basic-userid"><i class="bi bi-person"></i></span>
                    <div class="form-floating is-invalid">
                        <input type="text" class="form-control" id="emailinput" placeholder="User Id" asp-for="UserId">
                        <label for="emailinput">@Localizer[nameof(LoginModel.UserId)]</label>
                    
                    </div>
                    <span class="invalid-tooltip" style="right:0px" asp-validation-for="UserId"></span>

                </div>

                
            </div>
            <div class="col-12">
                <div class="input-group mb-3 has-validation">
                    <span class="input-group-text" id="basic-password"><i class="bi bi-key"></i></span>
                    <div class="form-floating is-invalid">
                        <input type="password" class="form-control" id="passwordinput" placeholder="Password" asp-for="Password">
                        <label for="passwordinput">@Localizer[nameof(LoginModel.Password)]</label>
                    
                    </div>
                    <span class="invalid-tooltip" style="right:0px" asp-validation-for="Password"></span>
                
                </div>

            </div>


            <button type="submit" class="btn btn-success">Login</button>
        </form>    



    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/material-design-modified.css" asp-append-version="true" />
}