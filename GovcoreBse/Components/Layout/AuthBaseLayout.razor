
@inherits LayoutComponentBase
@inject AppManager manner
@inject IJSRuntime js
@inject NavigationManager NavigationManager
@inject IOptions<PathSetting> Setting
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<HxMessenger Position="ToastContainerPosition.BottomCenter"  />
<HxMessageBoxHost  />
<HeadContent>
    <link href="css/HxHDefault-modified.css" rel="stylesheet" />

</HeadContent>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="/bookingcar.svg" alt="GovcoreBse Logo" width="30" height="24" class="d-inline-block" />
                GovcoreBse
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Home/Index">Go to Login</a>
                    </li>

                            
                </ul>
                @if (IsLogin)
                {
                    <div class="d-flex gap-2 ms-auto">
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-dark dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="visually-hidden">@(userDisplay)</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">Account Setting</a></li>
                                <li><a class="dropdown-item" href="/Home/Index?needClear=true">Logout</a></li>
                            </ul>
                            <button type="button" class="btn btn-sm btn-outline-dark">
                                @userDisplay
                            </button>
                        </div>
                        <div class="btn-group">
                            <button id="btnGroupDropLang" type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                🌐
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="btnGroupDropLang">
                                <li><a class="dropdown-item active" href="#" @onclick:preventDefault="true" @onclick="async ()=> await ChangeLanguage(DK.LANG_ENG)">English</a></li>
                                <li><a class="dropdown-item" href="#" @onclick:preventDefault="true" @onclick="async () => await ChangeLanguage(DK.LANG_CHI)">中文</a></li>
                            </ul>
                        </div>
                        <form id="langform" action="@Setting.Value.CultureSet" method="post" style="display:none" >
                            <AntiforgeryToken />
                            <input type="hidden" name="culture" value="@SelectedCulture" />
                            <input type="hidden" name="redirecturl" value="@(layoutState?.CurrentUrl)" />
                        </form>
                    </div>

                }
              
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        <div class="ribbon"></div>
        <AuthorizeView Context="authContext" >
            <Authorized>
                <PageTitle>@CardTitle</PageTitle>
                <div class="card-container">
                    <div class="card squeeze-mw shadow-elevation-2">
                            @Body
                    </div>
                </div>

            </Authorized>
            <NotAuthorized>
                <PageTitle>Not Authorized(@(CardTitle))</PageTitle>
                <h1>Not Authorized</h1>
                <p>@NotAuthorizedMessage</p>
            </NotAuthorized>

        </AuthorizeView>

        
    </main>
</div>
<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2023 - GovcoreBse - <a href="@(layoutState?.ReferrerUrl)">Back Url</a>
    </div>
</footer>


@code {
    [CascadingParameter(Name ="PageState")]
    private LayoutStateModel? layoutState { get; set; } ;

    [CascadingParameter(Name ="Title")]
    public string CardTitle { get; set; } = "You Unnamed Page";
    [CascadingParameter(Name = "NotAuthMsg")]
    public string NotAuthorizedMessage { get; set; } = "You are not authorized to view this page";


    private string userDisplay = string.Empty;
    private bool IsLogin = false;
    private string SelectedCulture { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        layoutState.OnLayoutChange += OnLayoutChanged;

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if(firstRender)
        {
            var userState = manner.UserState;
            if(userState!=null)
            {
                userDisplay = $"{userState.UserName}({userState.Post})".ToLowerInvariant();
                IsLogin = true;
            }

            StateHasChanged();
        }


    }
    private void OnLayoutChanged()
    {
        InvokeAsync(StateHasChanged);
    }


    public void Dispose()
    {
        layoutState.OnLayoutChange -= OnLayoutChanged;
    }



    private async Task ChangeLanguage(string culture)
    {
        SelectedCulture = culture;
        StateHasChanged();
        await Task.Yield();
        await js.InvokeVoidAsync("eval", "document.getElementById('langform').submit();");

    }
}
