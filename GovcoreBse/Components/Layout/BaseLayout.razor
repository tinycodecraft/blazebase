@inherits LayoutComponentBase
@inject AppManager manner
@inject LayoutStateModel globalState
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject AntiforgeryStateProvider Antiforgery
@inject IOptions<PathSetting> Setting

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="/bookingcar.svg" alt="GovcoreBse Logo" width="30" height="24" class="d-inline-block" />
                GovcoreBse
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Home/Index">Go to Login</a>
                    </li>

                            
                </ul>
                @if (globalState.IsLogin)
                {
                    <form class="d-flex">
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-dark dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="visually-hidden">@(userDisplay)</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">Account Setting</a></li>
                                <li><a class="dropdown-item" href="#">Logout</a></li>
                            </ul>
                            <button type="button" class="btn btn-sm btn-outline-dark">
                                @userDisplay
                            </button>
                        </div>
                        <div class="btn-group" role="group">
                            <button id="btnGroupDropLang" type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                🌐 Language
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="btnGroupDropLang">
                                <li><a class="dropdown-item active" href="#" @onclick="async ()=> await ChangeLanguage(DK.LANG_ENG)">English</a></li>
                                <li><a class="dropdown-item" href="#" @onclick="async () => await ChangeLanguage(DK.LANG_CHI)">中文</a></li>
                            </ul>
                        </div>
                    </form>

                }
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @Body
    </main>
</div>


@code {

    private string userDisplay = string.Empty;
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            userDisplay = $"{globalState.UserName}({globalState.Post})".ToLowerInvariant();
        }

        return base.OnAfterRenderAsync(firstRender);
    }

    private async Task ChangeLanguage(string culture)
    {
        if (string.IsNullOrEmpty(culture))
            return;
        var ftoken = Antiforgery.GetAntiforgeryToken()?.Value;
        if(ftoken == null)
        {
            return;
        }
        var payload = new Dictionary<string,string>
        {
            {"culture",culture },
            {CN.Setting.AntiForgeryFormField,ftoken}
        };

        using var request = new HttpRequestMessage(HttpMethod.Post, Setting.Value.CultureSet);
        request.Content = new FormUrlEncodedContent(payload);
        

        var response = await Http.SendAsync(request);
        if(response.IsSuccessStatusCode)
        {
            bool result = await response.Content.ReadFromJsonAsync<bool>();
            if(result)
            {
                NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
            }
        }
    }
}
