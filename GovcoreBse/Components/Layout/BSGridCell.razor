<div class="@CustomClasses">
    @ChildContent
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public Constants.WrapperSize Wrap { get; set; } =  Constants.WrapperSize.One;

    private string CustomClasses => Wrap switch
    {
        Constants.WrapperSize.One => "col-xl-3 col-md-3 col-sm-6 col-12",
        Constants.WrapperSize.Two => "col-xl-6 col-md-6 col-sm-12 col-12",
        Constants.WrapperSize.Three => "col-md-9 col-sm-9 col-12",
        Constants.WrapperSize.Four => "col-12",
        _ => "col-xl-3 col-md-3 col-sm-6 col-12"
        
    };

    


}